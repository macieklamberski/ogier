{
  "name": "ogier",
  "description": "Generate Open Graph images and meta tags for any page. Titles, sections and branding in, a themed PNG and a tag list out.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/ogier.git"
  },
  "bugs": {
    "url": "https://github.com/macieklamberski/ogier/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "open graph",
    "og image",
    "og:image",
    "social card",
    "social preview",
    "twitter card",
    "meta tags",
    "satori",
    "image generation",
    "vitepress"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean --unbundle --no-fixed-extension",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "kvalita": "^1.21.0",
    "trousse": "^2.1.0",
    "tsdown": "^0.23.0"
  }
}
