{
  "name": "ogier",
  "description": "Easily generate Open Graph images from text, icons and fonts, with ready-made layouts and themes, and adapters for your site framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/ogier.git"
  },
  "bugs": {
    "url": "https://github.com/macieklamberski/ogier/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "open graph",
    "og image",
    "og:image",
    "social card",
    "social preview",
    "twitter card",
    "meta tags",
    "satori",
    "image generation",
    "vitepress"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes/index.d.mts",
        "default": "./dist/themes/index.mjs"
      },
      "require": {
        "types": "./dist/themes/index.d.cts",
        "default": "./dist/themes/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.mts",
        "default": "./dist/adapters/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/index.d.cts",
        "default": "./dist/adapters/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/index.ts src/themes/index.ts src/adapters/index.ts --format cjs,esm --dts --clean --unbundle --shims",
    "test": "bun test",
    "examples": "cd examples && bun install && bun index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.33.4"
  },
  "peerDependencies": {
    "vitepress": ">=1"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tabler/icons": "^3.46.0",
    "@types/bun": "^1.4.2",
    "kvalita": "^1.23.0",
    "trousse": "^2.1.0",
    "tsdown": "^0.23.0",
    "vitepress": "^2.0.0-alpha.17"
  }
}
