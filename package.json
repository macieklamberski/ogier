{
  "name": "ogier",
  "description": "Easily generate Open Graph images from text, icons and fonts, with ready-made layouts and themes, and adapters for your site framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/ogier.git"
  },
  "bugs": {
    "url": "https://github.com/macieklamberski/ogier/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "open graph",
    "og image",
    "og:image",
    "social card",
    "social preview",
    "twitter card",
    "meta tags",
    "satori",
    "image generation",
    "vitepress"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./lite": {
      "types": "./dist/lite.d.mts",
      "default": "./dist/lite.mjs"
    },
    "./themes": {
      "types": "./dist/themes/index.d.mts",
      "default": "./dist/themes/index.mjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.mts",
      "default": "./dist/adapters/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/index.ts src/lite.ts src/themes/index.ts src/adapters/index.ts --format esm --dts --clean",
    "test": "bun test",
    "examples": "cd examples && bun install && bun index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.63.2"
  },
  "peerDependencies": {
    "vitepress": "^2.0.0-0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tabler/icons": "^3.49.0",
    "@types/bun": "^1.4.3",
    "kvalita": "^1.26.3",
    "trousse": "^2.13.0",
    "tsdown": "^0.23.2",
    "typescript": "7.1.0-beta",
    "vitepress": "^2.0.0-alpha.17"
  }
}
